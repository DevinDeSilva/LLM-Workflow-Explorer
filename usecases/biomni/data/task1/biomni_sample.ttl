Biomni:Data-id_20260504023543_48-data_lake_content a provone:Data ;
    rdfs:label "data_lake_content"^^xsd:string ;
    prov:value "[{\"description\": \"Immunologic signatures from MSigDB.\", \"name\": \"msigdb_human_c7_immunologic_signature_geneset.parquet\"}, {\"description\": \"Annotated genetic variants table.\", \"name\": \"variant_table.parquet\"}, {\"description\": \"Measured binding affinities between proteins and small molecules for drug discovery.\", \"name\": \"BindingDB_All_202409.tsv\"}, {\"description\": \"Regulatory target gene sets from MouseMine.\", \"name\": \"mousemine_m3_regulatory_target_geneset.parquet\"}, {\"description\": \"Genome-wide association studies (GWAS) results.\", \"name\": \"gwas_catalog.pkl\"}, {\"description\": \"Comprehensive gene information.\", \"name\": \"gene_info.parquet\"}, {\"description\": \"Ontology-based gene sets from MSigDB.\", \"name\": \"msigdb_human_c5_ontology_geneset.parquet\"}, {\"description\": \"Drug-drug interactions for alimentary tract and metabolism drugs from DDInter 2.0 database.\", \"name\": \"ddinter_alimentary_tract_metabolism.csv\"}, {\"description\": \"Control datapoints for all screening and profiling plates.\", \"name\": \"evebio_control_table.csv\"}, {\"description\": \"Succinct summary of results for each assay-compound combination.\", \"name\": \"evebio_summary_result_table.csv\"}, {\"description\": \"Synthetic lethal interactions.\", \"name\": \"synthetic_lethality.parquet\"}, {\"description\": \"Datasets from the Chan Zuckerberg Initiative's Cell Census.\", \"name\": \"czi_census_datasets_v4.parquet\"}, {\"description\": \"sgRNA knockout data for mouse.\", \"name\": \"sgRNA_KO_SP_mouse.txt\"}, {\"description\": \"Target metadata with common identifiers from EveBio screening.\", \"name\": \"evebio_target_table.csv\"}, {\"description\": \"Compounds from Enamine REAL library with SMILES annotations.\", \"name\": \"enamine_cloud_library_smiles.pkl\"}, {\"description\": \"Genetic disorders and associated genes from OMIM.\", \"name\": \"omim.parquet\"}, {\"description\": \"Molecules from Broad Institute's Drug Repurposing Hub with SMILES annotations.\", \"name\": \"broad_repurposing_hub_molecule_with_smiles.parquet\"}, {\"description\": \"Curated gene sets from MouseMine.\", \"name\": \"mousemine_m2_curated_geneset.parquet\"}, {\"description\": \"Cell type signature gene sets from MouseMine.\", \"name\": \"mousemine_m8_celltype_signature_geneset.parquet\"}, {\"description\": \"Predicted microRNA targets from miRDB.\", \"name\": \"miRDB_v6.0_results.parquet\"}, {\"description\": \"Protein interactions via proximity labeling and mass spectrometry.\", \"name\": \"proximity_label-ms.parquet\"}, {\"description\": \"Gene-disease associations from multiple sources.\", \"name\": \"DisGeNET.parquet\"}, {\"description\": \"Regulatory target gene sets from MSigDB.\", \"name\": \"msigdb_human_c3_regulatory_target_geneset.parquet\"}, {\"description\": \"Official HPO release in obographs format\", \"name\": \"hp.obo\"}, {\"description\": \"Synthetic growth defects from genetic interactions.\", \"name\": \"synthetic_growth_defect.parquet\"}, {\"description\": \"PubMed abstracts for microRNA-target interactions in miRTarBase.\", \"name\": \"miRTarBase_microRNA_target_interaction_pubmed_abtract.txt\"}, {\"description\": \"Gene expression (TPM) across human tissues from GTEx.\", \"name\": \"gtex_tissue_gene_tpm.parquet\"}, {\"description\": \"Precision medicine knowledge graph with 17,080 diseases and 4+ million relationships across biological scales.\", \"name\": \"kg.csv\"}, {\"description\": \"Hallmark gene sets from MouseMine.\", \"name\": \"mousemine_mh_hallmark_geneset.parquet\"}, {\"description\": \"Raw observed datapoints from all screening and profiling experiments.\", \"name\": \"evebio_observed_points_table.csv\"}, {\"description\": \"Predicted loss-of-function variants from GeneBass.\", \"name\": \"genebass_pLoF_filtered.pkl\"}, {\"description\": \"Drug-drug interactions for systemic hormonal preparations from DDInter 2.0 database.\", \"name\": \"ddinter_hormonal.csv\"}, {\"description\": \"Gene ontology data for functional gene annotations.\", \"name\": \"go-plus.json\"}, {\"description\": \"Drug-drug interactions for various drugs from DDInter 2.0 database.\", \"name\": \"ddinter_various.csv\"}, {\"description\": \"Cell type signatures from MSigDB.\", \"name\": \"msigdb_human_c8_celltype_signature_geneset.parquet\"}, {\"description\": \"Protein-protein interactions detected via affinity capture and mass spectrometry.\", \"name\": \"affinity_capture-ms.parquet\"}, {\"description\": \"Protein complexes reconstituted in vitro.\", \"name\": \"reconstituted_complex.parquet\"}, {\"description\": \"Protein expression data from Human Protein Atlas.\", \"name\": \"proteinatlas.tsv\"}, {\"description\": \"Positional gene sets from MouseMine.\", \"name\": \"mousemine_m1_positional_geneset.parquet\"}, {\"description\": \"Transcription factor targets from GTRD/MSigDB.\", \"name\": \"msigdb_human_c3_subset_transcription_factor_targets_from_GTRD.parquet\"}, {\"description\": \"Binding sites of microRNAs on target genes from miRTarBase.\", \"name\": \"miRTarBase_MicroRNA_Target_Sites.parquet\"}, {\"description\": \"T-cell receptor sequences and specificity data from McPAS database.\", \"name\": \"McPAS-TCR.parquet\"}, {\"description\": \"Computationally derived gene sets from MSigDB.\", \"name\": \"msigdb_human_c4_computational_geneset.parquet\"}, {\"description\": \"Drug-drug interactions for antiparasitic products from DDInter 2.0 database.\", \"name\": \"ddinter_antiparasitic.csv\"}, {\"description\": \"Drug-drug interactions for antineoplastic and immunomodulating agents from DDInter 2.0 database.\", \"name\": \"ddinter_antineoplastic.csv\"}, {\"description\": \"Drug-drug interactions for respiratory system drugs from DDInter 2.0 database.\", \"name\": \"ddinter_respiratory.csv\"}, {\"description\": \"Experimentally validated microRNA-target interactions from miRTarBase.\", \"name\": \"miRTarBase_microRNA_target_interaction.parquet\"}, {\"description\": \"Oncogenic signatures from MSigDB.\", \"name\": \"msigdb_human_c6_oncogenic_signature_geneset.parquet\"}, {\"description\": \"Filtered synonymous variants from GeneBass.\", \"name\": \"genebass_synonymous_filtered.pkl\"}, {\"description\": \"Metadata describing all cancer models/cell lines which are referenced by a dataset contained within the DepMap portal.\", \"name\": \"DepMap_Model.csv\"}, {\"description\": \"sgRNA knockout data for human.\", \"name\": \"sgRNA_KO_SP_human.txt\"}, {\"description\": \"Cell type marker genes for identification.\", \"name\": \"marker_celltype.parquet\"}, {\"description\": \"Genetic interactions between genes.\", \"name\": \"genetic_interaction.parquet\"}, {\"description\": \"Filtered missense variants from GeneBass.\", \"name\": \"genebass_missense_LC_filtered.pkl\"}, {\"description\": \"Protein-RNA interactions detected by affinity capture.\", \"name\": \"affinity_capture-rna.parquet\"}, {\"description\": \"Drug-drug interactions for blood and blood forming organs drugs from DDInter 2.0 database.\", \"name\": \"ddinter_blood_organs.csv\"}, {\"description\": \"Curated human gene sets from MSigDB.\", \"name\": \"msigdb_human_c2_curated_geneset.parquet\"}, {\"description\": \"Gene dosage changes affecting growth.\", \"name\": \"dosage_growth_defect.parquet\"}, {\"description\": \"Gene dependency probability estimates for cancer cell lines, including all DepMap models.\", \"name\": \"DepMap_CRISPRGeneDependency.csv\"}, {\"description\": \"Compound metadata with common identifiers from EveBio screening.\", \"name\": \"evebio_compound_table.csv\"}, {\"description\": \"Gene expression in TPMs for cancer cell lines, including all DepMap models.\", \"name\": \"DepMap_OmicsExpressionProteinCodingGenesTPMLogp1.csv\"}, {\"description\": \"Target subfamily bundles used for screening-to-profiling progression.\", \"name\": \"evebio_bundle_table.csv\"}, {\"description\": \"Protein-protein interactions from co-fractionation experiments.\", \"name\": \"co-fractionation.parquet\"}, {\"description\": \"Virus-host protein-protein interactions from P-HIPSTER.\", \"name\": \"Virus-Host_PPI_P-HIPSTER_2020.parquet\"}, {\"description\": \"Genetic interactions rescuing phenotypes.\", \"name\": \"synthetic_rescue.parquet\"}, {\"description\": \"Expanded results on evebio_summary_result_table with curve fit parameters and phase categories.\", \"name\": \"evebio_detailed_result_table.csv\"}, {\"description\": \"Prediction data for TXGNN.\", \"name\": \"txgnn_prediction.pkl\"}, {\"description\": \"Protein-protein interactions detected by yeast two-hybrid assays.\", \"name\": \"two-hybrid.parquet\"}, {\"description\": \"Ontology-based gene sets from MouseMine.\", \"name\": \"mousemine_m5_ontology_geneset.parquet\"}, {\"description\": \"Drug-drug interactions for dermatological drugs from DDInter 2.0 database.\", \"name\": \"ddinter_dermatological.csv\"}, {\"description\": \"Assay metadata with one row per assay from EveBio pharmome mapping.\", \"name\": \"evebio_assay_table.csv\"}, {\"description\": \"Drug phases, mechanisms of action, and target information from Broad Institute.\", \"name\": \"broad_repurposing_hub_phase_moa_target_info.parquet\"}, {\"description\": \"Human positional gene sets from MSigDB.\", \"name\": \"msigdb_human_c1_positional_geneset.parquet\"}, {\"description\": \"Name mapping for TXGNN.\", \"name\": \"txgnn_name_mapping.pkl\"}, {\"description\": \"Hallmark gene sets from MSigDB.\", \"name\": \"msigdb_human_h_hallmark_geneset.parquet\"}, {\"description\": \"Genome-wide CRISPR gene effect estimates for cancer cell lines, including all DepMap models.\", \"name\": \"DepMap_CRISPRGeneEffect.csv\"}]"^^xsd:string .

Biomni:Data-id_20260504023543_488-tool_desc a provone:Data ;
    rdfs:label "tool_desc"^^xsd:string ;
    prov:value """{"biomni.tool.biochemistry": [{"description": "Analyzes circular dichroism (CD) spectroscopy data to determine secondary structure and thermal stability.", "id": 8, "name": "analyze_circular_dichroism_spectra", "optional_parameters": [{"default": null, "description": "Temperature values (\\u00b0C) for thermal denaturation experiment", "name": "temperature_data", "type": "list or numpy.ndarray"}, {"default": null, "description": "CD signal values at specific wavelength across different temperatures", "name": "thermal_cd_data", "type": "list or numpy.ndarray"}, {"default": "./", "description": "Directory to save result files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Name of the biomolecule sample (e.g., \\"Znf706\\", \\"G-quadruplex\\")", "name": "sample_name", "type": "str"}, {"default": null, "description": "Type of biomolecule (\\"protein\\" or \\"nucleic_acid\\")", "name": "sample_type", "type": "str"}, {"default": null, "description": "Wavelength values in nm for CD spectrum", "name": "wavelength_data", "type": "list or numpy.ndarray"}, {"default": null, "description": "CD signal intensity values (typically in mdeg or \\u0394\\u03b5)", "name": "cd_signal_data", "type": "list or numpy.ndarray"}]}, {"description": "Calculate numeric values for various structural features of an RNA secondary structure.", "id": 9, "name": "analyze_rna_secondary_structure_features", "optional_parameters": [{"default": null, "description": "The RNA sequence corresponding to the structure. If provided, sequence-dependent energy calculations will be performed.", "name": "sequence", "type": "str"}], "required_parameters": [{"default": null, "description": "RNA secondary structure in dot-bracket notation (e.g., \\"(((...)))\\"). Parentheses represent base pairs, dots represent unpaired bases.", "name": "dot_bracket_structure", "type": "str"}]}, {"description": "Analyze protease kinetics data from fluorogenic peptide cleavage assays, fit the data to Michaelis-Menten kinetics, and determine key kinetic parameters.", "id": 10, "name": "analyze_protease_kinetics", "optional_parameters": [{"default": "protease_kinetics", "description": "Prefix for output files", "name": "output_prefix", "type": "str"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Array of time points (in seconds) at which measurements were taken", "name": "time_points", "type": "numpy.ndarray"}, {"default": null, "description": "2D array of fluorescence measurements where each row corresponds to a different substrate concentration and each column corresponds to a time point", "name": "fluorescence_data", "type": "numpy.ndarray"}, {"default": null, "description": "Array of substrate concentrations (in \\u03bcM) corresponding to each row in fluorescence_data", "name": "substrate_concentrations", "type": "numpy.ndarray"}, {"default": null, "description": "Concentration of the protease enzyme (in \\u03bcM)", "name": "enzyme_concentration", "type": "float"}]}, {"description": "Performs in vitro enzyme kinetics assay and analyzes the dose-dependent effects of modulators.", "id": 11, "name": "analyze_enzyme_kinetics_assay", "optional_parameters": [{"default": null, "description": "Dictionary of modulators where keys are modulator names and values are lists of concentrations in \\u03bcM", "name": "modulators", "type": "dict"}, {"default": null, "description": "Time points in minutes for time-course measurements", "name": "time_points", "type": "list or numpy.ndarray"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Name of the purified enzyme being tested", "name": "enzyme_name", "type": "str"}, {"default": null, "description": "List of substrate concentrations in \\u03bcM for kinetic analysis", "name": "substrate_concentrations", "type": "list or numpy.ndarray"}, {"default": null, "description": "Concentration of the enzyme in nM", "name": "enzyme_concentration", "type": "float"}]}, {"description": "Analyzes isothermal titration calorimetry (ITC) data to determine binding affinity and thermodynamic parameters.", "id": 12, "name": "analyze_itc_binding_thermodynamics", "optional_parameters": [{"default": null, "description": "Path to CSV or TSV file containing ITC thermogram data with columns for injection number, injection volume, and heat released/absorbed.", "name": "itc_data_path", "type": "str"}, {"default": null, "description": "Raw ITC thermogram data as a numpy array with shape (n_injections, 3) containing injection number, injection volume, and heat.", "name": "itc_data", "type": "numpy.ndarray"}, {"default": 298.15, "description": "Temperature in Kelvin at which the experiment was conducted.", "name": "temperature", "type": "float"}, {"default": null, "description": "Initial concentration of protein in the cell in molar (M).", "name": "protein_concentration", "type": "float"}, {"default": null, "description": "Concentration of ligand in the syringe in molar (M).", "name": "ligand_concentration", "type": "float"}], "required_parameters": []}, {"description": "Perform multiple sequence alignment and phylogenetic analysis to identify conserved protein regions.", "id": 13, "name": "analyze_protein_conservation", "optional_parameters": [{"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "List of protein sequences in FASTA format from multiple organisms.", "name": "protein_sequences", "type": "list of str"}]}], "biomni.tool.bioengineering": [{"description": "Analyze cell migration metrics from time-lapse microscopy images.", "id": 24, "name": "analyze_cell_migration_metrics", "optional_parameters": [{"default": 1.0, "description": "Conversion factor from pixels to micrometers", "name": "pixel_size_um", "type": "float"}, {"default": 1.0, "description": "Time interval between consecutive frames in minutes", "name": "time_interval_min", "type": "float"}, {"default": 10, "description": "Minimum number of frames a cell must be tracked to be included in analysis", "name": "min_track_length", "type": "int"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Path to the directory containing time-lapse images or path to a multi-frame TIFF file", "name": "image_sequence_path", "type": "str"}]}, {"description": "Simulates CRISPR-Cas9 genome editing process including guide RNA design, delivery, and analysis.", "id": 25, "name": "perform_crispr_cas9_genome_editing", "optional_parameters": [], "required_parameters": [{"default": null, "description": "List of guide RNA sequences (20 nucleotides each) targeting the genomic region of interest", "name": "guide_rna_sequences", "type": "List[str]"}, {"default": null, "description": "Target genomic sequence to be edited (should be longer than guide RNA and contain the target sites)", "name": "target_genomic_loci", "type": "str"}, {"default": null, "description": "Type of cell or tissue being edited (affects delivery efficiency and editing outcomes)", "name": "cell_tissue_type", "type": "str"}]}, {"description": "Analyze calcium imaging data to quantify neuronal activity metrics including cell counts, event rates, decay times, and signal-to-noise ratios.", "id": 26, "name": "analyze_calcium_imaging_data", "optional_parameters": [{"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Path to the time-series stack of fluorescence microscopy images (TIFF format)", "name": "image_stack_path", "type": "str"}]}, {"description": "Analyzes in vitro drug release kinetics from biomaterial formulations.", "id": 27, "name": "analyze_in_vitro_drug_release_kinetics", "optional_parameters": [{"default": "Drug", "description": "Name of the drug being analyzed", "name": "drug_name", "type": "str"}, {"default": null, "description": "Total amount of drug initially loaded in the formulation. If None, the maximum concentration is used as 100%", "name": "total_drug_loaded", "type": "float"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Time points at which drug concentrations were measured (in hours)", "name": "time_points", "type": "List[float] or numpy.ndarray"}, {"default": null, "description": "Measured drug concentration at each time point", "name": "concentration_data", "type": "List[float] or numpy.ndarray"}]}, {"description": "Quantifies morphological properties of myofibers in microscopy images of tissue sections.", "id": 28, "name": "analyze_myofiber_morphology", "optional_parameters": [{"default": 2, "description": "Channel index containing nuclei staining (DAPI, Hoechst, etc.)", "name": "nuclei_channel", "type": "int"}, {"default": 1, "description": "Channel index containing myofiber staining (\\u03b1-Actinin, etc.)", "name": "myofiber_channel", "type": "int"}, {"default": "otsu", "description": "Method for thresholding ('otsu', 'adaptive', or 'manual')", "name": "threshold_method", "type": "str"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Path to the microscopy image file (typically a multichannel image with nuclei and myofiber staining)", "name": "image_path", "type": "str"}]}, {"description": "Model neural activity trajectories and decode behavioral variables.", "id": 29, "name": "decode_behavior_from_neural_trajectories", "optional_parameters": [{"default": 10, "description": "Number of principal components to use for dimensionality reduction", "name": "n_components", "type": "int"}, {"default": "./", "description": "Directory to save output files", "name": "output_dir", "type": "str"}], "required_parameters": [{"default": null, "description": "Neural spiking activity data, shape (n_timepoints, n_neurons)", "name": "neural_data", "type": "numpy.ndarray"}, {"default": null, "description": "Behavioral data, shape (n_timepoints, n_behavioral_variables)", "name": "behavioral_data", "type": "numpy.ndarray"}]}, {"description": "Simulate a whole-cell model represented as a system of ordinary differential equations (ODEs).", "id": 30, "name": "simulate_whole_cell_ode_model", "optional_parameters": [{"default": null, "description": "Function defining the system of ODEs. Should take arguments (t, y, *args) where t is time, y is the state vector, and args contains additional parameters. If None, a simple example whole-cell model will be used.", "name": "ode_function", "type": "callable"}, {"default": "(0, 100)", "description": "Tuple of (start_time, end_time) for the simulation.", "name": "time_span", "type": "tuple"}, {"default": 1000, "description": "Number of time points to evaluate.", "name": "time_points", "type": "int"}, {"default": "'LSODA'", "description": "Numerical integration method to use (e.g., 'RK45', 'LSODA', 'BDF').", "name": "method", "type": "str"}], "required_parameters": [{"default": null, "description": "Initial values for each state variable in the model. If dict, keys are variable names and values are initial concentrations/values. If array-like, order must match the order expected by the ODE function.", "name": "initial_conditions", "type": "dict or array-like"}, {"default": null, "description": "Model parameters required by the ODE function. Keys are parameter names and values are parameter values.", "name": "parameters", "type": "dict"}]}], "biomni.tool.bioimaging": [{"description": "Split a 4D NIfTI file into separate modality files for nnUNet processing. Handles 
...[truncated]"""^^xsd:string .

