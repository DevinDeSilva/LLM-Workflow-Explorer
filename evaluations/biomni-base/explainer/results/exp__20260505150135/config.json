{"application": {"description": "The Biomni application is an LLM-driven biomedical agent that plans, reasons,\nexecutes generated code, and optionally critiques intermediate answers to solve\nuser-provided biomedical tasks. The provenance captures the user input, system\nprompt generation, each agent generation iteration, code execution, execution\nobservations, final solution, and optional critic feedback as intermediary\nstates of the agent run.\nAgent stages are represented as provone:Executions of provone:Programs,\nincluding user input recording, system prompt generation, LLM response\ngeneration, generated code execution, and critic review. LLM usage within the\nagent is represented as workflow:Generative_Task activity using\nworkflow:Large_Language_Models. Generated responses, executable code,\nobservations, critic feedback, and final solutions are connected across the\nworkflow using provone:Channel and prov:wasInformedBy relations.\ndcterms:identifier represents the unique identifier for each recorded agent\nstage or experiment step.\n"}, "file_paths": {"schema_loc": "schema/schemaV2.json", "execution_kg_loc": "usecases/biomni/data/task3/biomni_sample.ttl", "metadata_loc": "usecases/biomni/data/task3/biomni_sample_metadata.json", "ontology_path": "schema/WorkFlow.ttl"}, "explorer_config": {"kg_name": "Biomni-Task3", "ontology_triples_path": "schema/extracted_ontology_triples.csv", "parallel": true, "temp_folder": "evaluations/biomni-base/exeprog_creation/tmp/programs", "use_cache": false, "explorer_metadata_loc": "evaluations/biomni-base/exeprog_creation/exeplorer_metadata.pkl", "exeprog_save_loc": "evaluations/biomni-base/exeprog_creation/exeplored_programs.pkl", "entity_length": 5, "log_file": "evaluations/biomni-base/exeprog_creation/explorer_log.txt"}, "question_creation_config": {"save_questions": "evaluations/biomni-base/ques_creation/SyntheticQuestionKG.csv", "llm_type": "lmstudio", "llm_config": {"model": "openai/gpt-oss-20b", "base_url": "http://localhost:1234/v1"}, "log_file": "evaluations/biomni-base/ques_creation/question_creation_log.txt"}, "explainer_config": {"llm_type": "lmstudio", "embedding_type": "lmstudio", "vectordb_type": "milvus", "save_answer_loc": "evaluations/biomni-base/explainer/results", "llm_config": {"model": "openai/gpt-oss-20b", "base_url": "http://localhost:1234/v1"}, "embedding_config": {"model": "text-embedding-bge-large-en-v1.5"}, "vectordb_config": {"vector_dim": 1024, "collection_name": "biomni"}, "object_search_config": {"search_limit": 3}, "log_file": "evaluations/biomni-base/explainer/explainer_log.txt"}, "ttl": {"prefixes": [{"name": "provone", "uri": "http://purl.dataone.org/provone/2015/01/15/ontology#"}, {"name": "skos", "uri": "http://www.w3.org/2004/02/skos/core#"}, {"name": "prov", "uri": "http://www.w3.org/ns/prov#"}, {"name": "rdfs", "uri": "http://www.w3.org/2000/01/rdf-schema#"}, {"name": "rdf", "uri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"}, {"name": "cwfo", "uri": "http://cwf.tw.rpi.edu/vocab#"}, {"name": "dcterms", "uri": "http://purl.org/dc/terms#"}, {"name": "Biomni", "uri": "http://testwebsite/testProgram#"}, {"name": "user", "uri": "http://testwebsite/testUser#"}, {"name": "eo", "uri": "https://purl.org/heals/eo#"}, {"name": "ep", "uri": "http://linkedu.eu/dedalo/explanationPattern.owl#"}, {"name": "sio", "uri": "http://semanticscience.org/resource/"}, {"name": "dc", "uri": "http://purl.org/dc/elements/1.1/"}, {"name": "DFColumn", "uri": "http://testwebsite/testDFColumn#"}, {"name": "fnom", "uri": "https://w3id.org/function/vocabulary/mapping#"}, {"name": "fnoi", "uri": "https://w3id.org/function/vocabulary/implementation#"}, {"name": "fnoc", "uri": "https://w3id.org/function/vocabulary/composition/0.1.0/"}, {"name": "food", "uri": "http://purl.org/heals/food/"}, {"name": "dbo", "uri": "http://dbpedia.org/ontology/"}, {"name": "dbp", "uri": "http://dbpedia.org/property/"}, {"name": "dbt", "uri": "http://dbpedia.org/resource/Template:"}, {"name": "ques